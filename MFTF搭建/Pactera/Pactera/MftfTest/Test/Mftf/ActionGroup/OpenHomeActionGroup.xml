<?xml version="1.0" encoding="UTF-8"?>
<!-- 打开首页 -->
<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="OpenHomeActionGroup">
        <annotations>
            <description value="Open Front Page." />
        </annotations>
        <arguments>
            <argument name="picName" defaultValue="" type="string" />
        </arguments>
		<!-- 
			1-1. 打开 home 页面，1-2. 调整 home 页面的窗口大小，1-3. 页面截图保存文件
		-->
        <amOnPage url="{{StorefrontHomePage.url}}" stepKey="navigateToFrontHome" />
        <resizeWindow width="2560" height="4000" stepKey="navigateToFrontHomeResizeWindow" />
        <makeScreenshot userInput="{{picName}}-1-home-page" stepKey="navigateToFrontHomeScreenshot" />
    </actionGroup>
</actionGroups>
