<?xml version="1.0" encoding="UTF-8"?>
<!-- 信通卡支付 -->
<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="PayCreditCardActionGroup">
        <annotations>
            <description value="Pay Credit Card." />
        </annotations>
        <arguments>
            <argument name="picName" defaultValue="" type="string" />
        </arguments>
        <!-- 
			1-1. 点击信用卡支付，1-2. 调整窗口大小，1-3. 页面截图保存文件
		-->
        <click selector="#sbps_cc" stepKey="creditCardSelected" />
        <waitForPageLoad stepKey="creditCardSelectedWaitFor" />
        <resizeWindow width="2560" height="1440" stepKey="creditCardSelectedResizeWindow" />
        <makeScreenshot userInput="{{picName}}-1-pay-credit-card" stepKey="creditCardSelectedScreenshot" />
    </actionGroup>
</actionGroups>